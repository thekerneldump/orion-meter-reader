# Exact EEPROM serial of the RTL-SDR dedicated to Orion reception.
SDR_SERIAL=ORION

# Optional comma-separated endpoint IDs. Leave blank to retain every decoded ID.
METER_IDS=

# Scan the North American 900 MHz ISM band using repeated rtl_433 -f options.
FREQUENCY=905.2M
SAMPLE_RATE=1600k
GAIN=0
RTL433_EXTRA_ARGS=-f 906.8M -f 908.4M -f 910.0M -f 911.6M -f 913.2M -f 914.8M -f 916.4M -f 918.0M -f 919.6M -f 921.2M -f 922.8M -f 924.4M -H 5

# Optional fixed-center recentering. Use exactly one METER_IDS value and set
# RTL433_EXTRA_ARGS=none when enabling this mode.
AUTO_RECENTER_ENABLED=false
AUTO_RECENTER_THRESHOLD_MHZ=0.35
AUTO_RECENTER_MIN_PACKETS=5
AUTO_RECENTER_WINDOW_SECONDS=300
AUTO_RECENTER_COOLDOWN_SECONDS=900

HTTP_BIND=0.0.0.0
HTTP_PORT=8083
MAX_JSONL_BYTES=104857600
JSONL_ROTATE_COUNT=4

# Optional authenticated API for production and auxiliary SDR control. The token
# enables production retuning. List only auxiliary radios that may also be used.
RADIO_CONTROL_TOKEN=
RADIO_CONTROL_SERIALS=
